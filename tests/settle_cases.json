  {
    "name": "p_max_pu-over-the-generators",
    "doc": "The example of `settle` on the reference page on the record, with `snapshot` outside `labels`.",
    "columns": [
      { "name": "entity", "type": "VARCHAR" },
      { "name": "snapshot", "type": "INTEGER" },
      { "name": "attribute", "type": "VARCHAR" },
      { "name": "breakpoint", "type": "DOUBLE" },
      { "name": "value", "type": "DOUBLE" }
    ],
    "rows": [
      ["wind", 0, "p_max_pu", null, 0.3],
      ["wind", 1, "p_max_pu", null, 0.8],
      ["wind", 2, "p_max_pu", null, 0.5],
      [null, null, "p_max_pu", null, 1.0]
    ],
    "labels": { "entity": ["wind", "gas"] },
    "filter": true,
    "expected": [
      ["gas", null, "p_max_pu", null, 1.0],
      ["wind", 0, "p_max_pu", null, 0.3],
      ["wind", 1, "p_max_pu", null, 0.8],
      ["wind", 2, "p_max_pu", null, 0.5],
      ["wind", null, "p_max_pu", null, 1.0]
    ]
  }
]
